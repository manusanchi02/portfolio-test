{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "projects.schema.json",
  "title": "Projects (order of the array is the order in the grid)",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["slug", "title", "visible", "banner"],
    "additionalProperties": false,
    "properties": {
      "slug": { "$ref": "common.schema.json#/definitions/slug" },
      "title": { "type": "string", "minLength": 1 },
      "summary": { "type": "string" },
      "visible": { "type": "boolean" },
      "banner": { "$ref": "common.schema.json#/definitions/image" },
      "blocks": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["text", "image", "image-grid"] }
          },
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "text" } } },
              "then": {
                "required": ["text"],
                "additionalProperties": false,
                "properties": {
                  "type": {},
                  "text": { "$ref": "common.schema.json#/definitions/inlineHtml" }
                }
              }
            },
            {
              "if": { "properties": { "type": { "const": "image" } } },
              "then": {
                "required": ["image"],
                "additionalProperties": false,
                "properties": {
                  "type": {},
                  "image": { "$ref": "common.schema.json#/definitions/image" }
                }
              }
            },
            {
              "if": { "properties": { "type": { "const": "image-grid" } } },
              "then": {
                "required": ["images"],
                "additionalProperties": false,
                "properties": {
                  "type": {},
                  "images": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "common.schema.json#/definitions/image" }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
