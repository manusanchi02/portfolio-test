{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "about.schema.json",
  "title": "About section",
  "type": "object",
  "required": ["photo", "text"],
  "additionalProperties": false,
  "properties": {
    "photo": { "$ref": "common.schema.json#/definitions/image" },
    "text": { "$ref": "common.schema.json#/definitions/inlineHtml" },
    "links": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/link" }
    }
  }
}
