{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "site.schema.json",
  "title": "Site settings",
  "type": "object",
  "required": ["name", "description"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "extraMenuLinks": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/link" }
    },
    "social": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/definitions/link" }
    },
    "instagramPostsShown": { "type": "integer", "minimum": 1, "maximum": 12 }
  }
}
